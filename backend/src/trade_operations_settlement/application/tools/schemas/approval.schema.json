{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalAndDecisionSchemas",
  "description": "JSON Schemas for approval cycles, decision commands, amendments, and results",
  "$defs": {
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "Amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "value_date", "reason_code"],
      "properties": {
        "amount": { "$ref": "#/$defs/Money" },
        "value_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "reason_code": { "type": "string", "minLength": 1 }
      }
    },
    "ApprovalDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "action", "actor_display", "recorded_at"],
      "properties": {
        "decision_id": { "type": "string" },
        "action": { "type": "string", "enum": ["approve", "amend", "reject"] },
        "actor_display": { "type": "string" },
        "note": { "type": ["string", "null"] },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "ApprovalCycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_cycle_id",
        "case_id",
        "case_version",
        "proposal_id",
        "policy_decision_id",
        "required_approvals",
        "state"
      ],
      "properties": {
        "approval_cycle_id": { "type": "string" },
        "case_id": { "type": "string" },
        "case_version": { "type": "integer", "minimum": 1 },
        "proposal_id": { "type": "string" },
        "policy_decision_id": { "type": "string" },
        "required_approvals": { "type": "integer", "minimum": 1 },
        "state": {
          "type": "string",
          "enum": ["pending", "satisfied", "rejected", "superseded"]
        },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/ApprovalDecision" }
        }
      }
    },
    "DecisionCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "expected_case_version",
        "evidence_set_id",
        "proposal_version",
        "policy_decision_id",
        "approval_cycle_id"
      ],
      "properties": {
        "action": { "type": "string", "enum": ["approve", "amend", "reject"] },
        "expected_case_version": { "type": "integer", "minimum": 1 },
        "evidence_set_id": { "type": "string" },
        "proposal_version": { "type": "integer", "minimum": 1 },
        "policy_decision_id": { "type": "string" },
        "approval_cycle_id": { "type": "string" },
        "note": { "type": ["string", "null"], "maxLength": 4000 },
        "amendment": {
          "anyOf": [
            { "$ref": "#/$defs/Amendment" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "amend" } } },
          "then": {
            "required": ["note", "amendment"],
            "properties": {
              "note": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "amendment": { "$ref": "#/$defs/Amendment" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "reject" } } },
          "then": {
            "required": ["note"],
            "properties": {
              "note": { "type": "string", "minLength": 1, "maxLength": 4000 }
            }
          }
        }
      ]
    },
    "DecisionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_version",
        "state",
        "cycle_state",
        "decision_id",
        "actor_display",
        "decided_at"
      ],
      "properties": {
        "case_id": { "type": "string" },
        "case_version": { "type": "integer", "minimum": 1 },
        "state": { "type": "string" },
        "cycle_state": { "type": "string" },
        "decision_id": { "type": "string" },
        "actor_display": { "type": "string" },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
