# ==============================================================================
# Trade Operations & Settlement - Environment Configuration
# ==============================================================================

# AI Framework / Provider Selection
# PortAgent built-in framework adapters: openai | adk | langgraph | crewai | semantic_kernel
AI_PROVIDER=openai
FRAMEWORK=openai

# OpenAI Provider Configuration (used when AI_PROVIDER=openai)
# Configure your local key in .env (never commit .env).
OPENAI_API_KEY=sk-placeholder-key
OPENAI_MODEL=gpt-4.1

# Orchestration Mode
# Supported PortAgent orchestration modes: sequential | parallel | hierarchical
ORCHESTRATION_MODE=sequential
PARALLEL_MAX_WORKERS=4
SUPERVISOR_AGENT_ID=supervisor

# Operating Environment Mode
# synthetic | production
TRADE_OPS_ENV=synthetic

# Model Context Protocol (MCP) Tool Endpoint
# Optional URL for remote MCP tool server (leave empty to run tools in-process)
TRADE_OPS_MCP_ENDPOINT=
