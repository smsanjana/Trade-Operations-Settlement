# Synthetic Test Profile (Local / Isolated Non-Production Testing Only)
# Production or shared environments MUST refuse this profile.

TRADE_OPS_ENVIRONMENT=synthetic
TRADE_OPS_ALLOWED_ORIGINS=["http://localhost:3000"]
TRADE_OPS_HOST=0.0.0.0
TRADE_OPS_PORT=8000

# Adapter Modes - Explicit synthetic connectors and no-ledger posting boundary
TRADE_OPS_SOURCE_ADAPTER=synthetic
TRADE_OPS_POSTING_ADAPTER=no_ledger_synthetic
TRADE_OPS_EVIDENCE_STORE_ADAPTER=synthetic_object_store
TRADE_OPS_DATASTORE_ADAPTER=synthetic_relational
TRADE_OPS_MODEL_ADAPTER=portagent_stub

# Policy and Thresholds (Test Values)
TRADE_OPS_POLICY_VERSION=synthetic-policy-v1
TRADE_OPS_CONFIDENCE_THRESHOLD=0.95
TRADE_OPS_AUTO_POST_LIMIT=10000.00
TRADE_OPS_DUAL_CONTROL_THRESHOLD=100000.00
TRADE_OPS_VOLUNTARY_DEADLINE_WINDOW_HOURS=48

# Frontend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
